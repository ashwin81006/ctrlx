<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- Main Content Container for the 3 Tab Screens -->
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar">

        <!-- ============================================== -->
        <!-- TAB 1: CONNECT & SCANNER SCREEN               -->
        <!-- ============================================== -->
        <ScrollView
            android:id="@+id/layoutConnect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CTRLX"
                    android:textColor="#F8FAFC"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wireless Controller &amp; Touchpad"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <!-- Scan Status & Rescan Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#131D31"
                    android:padding="12dp"
                    android:layout_marginTop="20dp">

                    <ProgressBar
                        android:id="@+id/scanProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp" />

                    <TextView
                        android:id="@+id/scanStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Scanning local Wi-Fi for PCs..."
                        android:textColor="#38BDF8"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/rescanButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Rescan"
                        android:textColor="#F8FAFC"
                        android:textSize="11sp"
                        android:background="#1E293B"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE COMPUTERS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp" />

                <!-- Discovered PCs List Container (Dynamically populated with all laptops) -->
                <LinearLayout
                    android:id="@+id/discoveredPcList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>




        <!-- ============================================== -->
        <!-- TAB 3: TOUCHPAD CONTROLLER (Monect style)     -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutTouchpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <!-- Hidden EditText for Soft Keyboard IME -->
            <EditText
                android:id="@+id/hiddenKeyInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:background="@android:color/transparent"
                android:inputType="textMultiLine|textNoSuggestions"
                android:imeOptions="flagNoExtractUi|actionSend"
                android:alpha="0" />

            <!-- Top Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/touchpadPcBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● Windows PC"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Soft Keyboard Toggle Button -->
                <Button
                    android:id="@+id/touchpadKeyboardBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⌨️ Keyboard"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp" />

                <!-- Power Actions Button -->
                <Button
                    android:id="@+id/touchpadPowerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⚡ Power"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp" />

                <!-- Disconnect Button -->
                <Button
                    android:id="@+id/touchpadDisconnectBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Disconnect"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

            </LinearLayout>

            <!-- Touchpad Surface -->
            <FrameLayout
                android:id="@+id/touchpadSurface"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#131B2E"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="TOUCHPAD\n\nDrag: Pointer • Tap: Click\nTwo-Finger Scroll"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp" />

                <!-- Vertical Scroll Strip on Right Edge -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="32dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:text="SCROLL"
                    android:textColor="#334155"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Media Controls Bar (Pill design) -->
            <LinearLayout
                android:id="@+id/mediaControlsBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:background="#131B2E"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnMediaPrev"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:text="⏮"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnMediaPlayPause"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.2"
                    android:background="#2563EB"
                    android:text="⏯"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnMediaNext"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:text="⏭"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnMediaVolDown"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.1"
                    android:background="#1E293B"
                    android:text="🔉 -"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnMediaVolUp"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1.1"
                    android:background="#1E293B"
                    android:text="🔊 +"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnMediaMute"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:text="🔇"
                    android:textColor="#EF4444"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Bottom Mouse Click Pads (Monect Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/leftClickButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="3"
                    android:background="#2563EB"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="LEFT CLICK" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/rightClickButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="2"
                    android:background="#1E293B"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="RIGHT CLICK" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================== -->
        <!-- TAB 3: XBOX GAMEPAD CONTROLLER (HORIZONTAL)    -->
        <!-- ============================================== -->
        <!-- ============================================== -->
        <!-- TAB 3: XBOX GAMEPAD CONTROLLER (HORIZONTAL)    -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutGamepad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_gamepad"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Hidden helpers to satisfy existing MainActivity references -->
                <TextView
                    android:id="@+id/gamepadPcBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/gamepadProfileBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/gamepadRotateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <!-- ================= TOP BUTTONS ROW ================= -->
                <!-- LT | LB | Guid | RB | RT (Spanning full top width with Monect pills) -->
                <LinearLayout
                    android:id="@+id/topButtonsBar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_alignParentTop="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp">

                    <!-- Subtle Exit/Back Button -->
                    <Button
                        android:id="@+id/gamepadBackBtn"
                        android:layout_width="38dp"
                        android:layout_height="44dp"
                        android:text="‹"
                        android:textColor="#38BDF8"
                        android:textSize="20sp"
                        android:background="@drawable/btn_gamepad_pill"
                        android:layout_marginEnd="6dp" />

                    <!-- Layout Editor Button -->
                    <Button
                        android:id="@+id/gamepadEditBtn"
                        android:layout_width="38dp"
                        android:layout_height="44dp"
                        android:text="⚙"
                        android:textColor="#38BDF8"
                        android:textSize="18sp"
                        android:background="@drawable/btn_gamepad_pill"
                        android:layout_marginEnd="6dp" />

                    <!-- Quick Media Controls Button -->
                    <Button
                        android:id="@+id/gamepadMediaBtn"
                        android:layout_width="38dp"
                        android:layout_height="44dp"
                        android:text="🎵"
                        android:textColor="#38BDF8"
                        android:textSize="16sp"
                        android:background="@drawable/btn_gamepad_pill"
                        android:layout_marginEnd="6dp" />

                    <!-- Quick Power Actions Button -->
                    <Button
                        android:id="@+id/gamepadPowerBtn"
                        android:layout_width="38dp"
                        android:layout_height="44dp"
                        android:text="⚡"
                        android:textColor="#F59E0B"
                        android:textSize="16sp"
                        android:background="@drawable/btn_gamepad_pill"
                        android:layout_marginEnd="8dp" />

                    <!-- Left Trigger LT -->
                    <Button
                        android:id="@+id/btnLT"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.2"
                        android:text="LT"
                        android:textColor="#E0F2FE"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- Left Bumper LB -->
                    <Button
                        android:id="@+id/btnLB"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.0"
                        android:layout_marginStart="8dp"
                        android:text="LB"
                        android:textColor="#E0F2FE"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- Center Spacer -->
                    <View
                        android:layout_width="20dp"
                        android:layout_height="1dp" />

                    <!-- Guide Button (Monect style Guid) -->
                    <Button
                        android:id="@+id/btnXboxGuide"
                        android:layout_width="80dp"
                        android:layout_height="44dp"
                        android:text="Guid"
                        android:textColor="#E0F2FE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- Center Spacer -->
                    <View
                        android:layout_width="20dp"
                        android:layout_height="1dp" />

                    <!-- Right Bumper RB -->
                    <Button
                        android:id="@+id/btnRB"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.0"
                        android:layout_marginEnd="8dp"
                        android:text="RB"
                        android:textColor="#E0F2FE"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- Right Trigger RT -->
                    <Button
                        android:id="@+id/btnRT"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1.2"
                        android:text="RT"
                        android:textColor="#E0F2FE"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                </LinearLayout>

                <!-- ================= LAYOUT EDITOR OVERLAY TOOLBAR ================= -->
                <LinearLayout
                    android:id="@+id/editModeOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_alignParentTop="true"
                    android:background="#E6091220"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone"
                    android:elevation="24dp">

                    <TextView
                        android:id="@+id/editorTargetLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tap control to select • Drag to move"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Size adjustment controls -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size:"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnScaleDown"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:text="−"
                        android:textColor="#F8FAFC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                    <TextView
                        android:id="@+id/editorScaleText"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="100%"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnScaleUp"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:text="+"
                        android:textColor="#F8FAFC"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <!-- Reset to default layout button -->
                    <Button
                        android:id="@+id/btnEditorReset"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Reset"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />

                    <View
                        android:layout_width="6dp"
                        android:layout_height="1dp" />

                    <!-- Save & Exit button -->
                    <Button
                        android:id="@+id/btnEditorDone"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Save ✓"
                        android:textColor="#10B981"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                </LinearLayout>

                <!-- ================= CENTER CLUSTER ================= -->
                <!-- Back, Start / LS, RS (2x2 Grid matching Monect) -->
                <LinearLayout
                    android:id="@+id/centerCluster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/topButtonsBar"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- Row 1: Back & Start -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnView"
                            android:layout_width="66dp"
                            android:layout_height="32dp"
                            android:text="Back"
                            android:textColor="#E0F2FE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_gamepad_pill" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnMenu"
                            android:layout_width="66dp"
                            android:layout_height="32dp"
                            android:text="Start"
                            android:textColor="#E0F2FE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_gamepad_pill" />

                    </LinearLayout>

                    <!-- Row 2: LS & RS Click Buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnL3"
                            android:layout_width="66dp"
                            android:layout_height="32dp"
                            android:text="LS"
                            android:textColor="#E0F2FE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_gamepad_pill" />

                        <View
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnR3"
                            android:layout_width="66dp"
                            android:layout_height="32dp"
                            android:text="RS"
                            android:textColor="#E0F2FE"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_gamepad_pill" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ================= LEFT SECTION ================= -->
                <!-- Left Analog Stick (TOP-LEFT position per Monect layout) -->
                <com.ctrlx.mobile.JoystickView
                    android:id="@+id/leftStick"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_below="@id/topButtonsBar"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="14dp" />

                <!-- Monect-Style 4-Pill D-Pad Cross (Lower-Left, Shifted Inward) -->
                <RelativeLayout
                    android:id="@+id/dpadCluster"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_below="@id/leftStick"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="96dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp">

                    <!-- UP arm (vertical capsule) -->
                    <Button
                        android:id="@+id/btnDpadUp"
                        android:layout_width="28dp"
                        android:layout_height="52dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- DOWN arm (vertical capsule) -->
                    <Button
                        android:id="@+id/btnDpadDown"
                        android:layout_width="28dp"
                        android:layout_height="52dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- LEFT arm (horizontal capsule) -->
                    <Button
                        android:id="@+id/btnDpadLeft"
                        android:layout_width="52dp"
                        android:layout_height="28dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_gamepad_pill" />

                    <!-- RIGHT arm (horizontal capsule) -->
                    <Button
                        android:id="@+id/btnDpadRight"
                        android:layout_width="52dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/btn_gamepad_pill" />

                </RelativeLayout>

                <!-- ================= RIGHT SECTION ================= -->
                <!-- ABXY Diamond Cluster (Covers Right Part of Screen in Equal Sized Squircles) -->
                <RelativeLayout
                    android:id="@+id/abxyCluster"
                    android:layout_width="250dp"
                    android:layout_height="230dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp">

                    <!-- Y Button (Top, 82x66dp Squircle) -->
                    <Button
                        android:id="@+id/btnY"
                        android:layout_width="82dp"
                        android:layout_height="66dp"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:text="Y"
                        android:textColor="#E0F2FE"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_rect" />

                    <!-- X Button (Left, 82x66dp Squircle) -->
                    <Button
                        android:id="@+id/btnX"
                        android:layout_width="82dp"
                        android:layout_height="66dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="X"
                        android:textColor="#E0F2FE"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_rect" />

                    <!-- B Button (Right, 82x66dp Squircle) -->
                    <Button
                        android:id="@+id/btnB"
                        android:layout_width="82dp"
                        android:layout_height="66dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="B"
                        android:textColor="#E0F2FE"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_rect" />

                    <!-- A Button (Bottom, 82x66dp Squircle) -->
                    <Button
                        android:id="@+id/btnA"
                        android:layout_width="82dp"
                        android:layout_height="66dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:text="A"
                        android:textColor="#E0F2FE"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_gamepad_rect" />

                </RelativeLayout>

                <!-- Right Analog Stick (Lower-Center/Right, Left of ABXY per Monect layout) -->
                <com.ctrlx.mobile.JoystickView
                    android:id="@+id/rightStick"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_toStartOf="@id/abxyCluster"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp" />

            </RelativeLayout>

        </LinearLayout>

    </FrameLayout>


    <!-- ============================================== -->
    <!-- MONECT-STYLE BOTTOM NAVIGATION BAR             -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#0F172A"
        android:gravity="center_vertical">

        <!-- Tab 1: Connect -->
        <LinearLayout
            android:id="@+id/navTabConnect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navIconConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navLabelConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Tab 2: Touchpad -->
        <LinearLayout
            android:id="@+id/navTabTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navIconTouchpad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖱️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navLabelTouchpad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touchpad"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Tab 3: Gamepad -->
        <LinearLayout
            android:id="@+id/navTabGamepad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navIconGamepad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navLabelGamepad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gamepad"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>