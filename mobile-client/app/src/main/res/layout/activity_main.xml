<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19">

    <!-- Main Content Container for the 3 Tab Screens -->
    <FrameLayout
        android:id="@+id/tabContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar">

        <!-- ============================================== -->
        <!-- TAB 1: CONNECT & SCANNER SCREEN               -->
        <!-- ============================================== -->
        <ScrollView
            android:id="@+id/layoutConnect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CTRLX"
                    android:textColor="#F8FAFC"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PC Remote Receiver Discovery"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <!-- Scan Status & Rescan Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#131D31"
                    android:padding="12dp"
                    android:layout_marginTop="20dp">

                    <ProgressBar
                        android:id="@+id/scanProgress"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp" />

                    <TextView
                        android:id="@+id/scanStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Scanning local Wi-Fi for PCs..."
                        android:textColor="#38BDF8"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/rescanButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Rescan"
                        android:textColor="#F8FAFC"
                        android:textSize="11sp"
                        android:background="#1E293B"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVAILABLE RECEIVERS"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp" />

                <!-- Discovered PCs List Container (Dynamically populated with all laptops) -->
                <LinearLayout
                    android:id="@+id/discoveredPcList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>




        <!-- ============================================== -->
        <!-- TAB 3: TOUCHPAD CONTROLLER (Monect style)     -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutTouchpad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <!-- Top Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/touchpadPcBadge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● Windows PC"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Disconnect Button -->
                <Button
                    android:id="@+id/touchpadDisconnectBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Disconnect"
                    android:textColor="#EF4444"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </LinearLayout>

            <!-- Touchpad Surface -->
            <FrameLayout
                android:id="@+id/touchpadSurface"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#131B2E"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="TOUCHPAD\n\nDrag: Pointer • Tap: Click\nTwo-Finger Scroll"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="4dp" />

                <!-- Vertical Scroll Strip on Right Edge -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_marginEnd="32dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="#1E293B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:text="SCROLL"
                    android:textColor="#334155"
                    android:textSize="9sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Bottom Mouse Click Pads (Monect Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/leftClickButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="3"
                    android:background="#2563EB"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="LEFT CLICK" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />

                <Button
                    android:id="@+id/rightClickButton"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="2"
                    android:background="#1E293B"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="RIGHT CLICK" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================== -->
        <!-- TAB 3: XBOX GAMEPAD CONTROLLER (HORIZONTAL)    -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutGamepad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#0B0F19"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <!-- Gamepad Top Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <Button
                    android:id="@+id/gamepadBackBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="‹ TOUCHPAD"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#1E293B"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <TextView
                    android:id="@+id/gamepadPcBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="🎮 XBOX GAMEPAD"
                    android:textColor="#34D399"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Game Profile Toggle (FPS / Racing / Retro) -->
                <Button
                    android:id="@+id/gamepadProfileBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="FPS / Action ▾"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp" />

                <!-- Screen Orientation Toggle -->
                <Button
                    android:id="@+id/gamepadRotateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:text="⛶ Rotate"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:background="#1E293B"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>

            <!-- Main Horizontal Console Area: Left Wing | Center Console | Right Wing -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- ================= LEFT WING ================= -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- Left Shoulder Buttons (LT & LB) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="start|center_vertical"
                        android:paddingStart="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <Button
                            android:id="@+id/btnLT"
                            android:layout_width="84dp"
                            android:layout_height="36dp"
                            android:text="LT"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_xbox_trigger" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <Button
                            android:id="@+id/btnLB"
                            android:layout_width="74dp"
                            android:layout_height="36dp"
                            android:text="LB"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_xbox_shoulder" />

                    </LinearLayout>

                    <!-- Left Thumb Controls (Left Analog Stick & D-Pad Cross) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Left Analog Stick (LS + L3) -->
                        <RelativeLayout
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_marginEnd="8dp">

                            <com.ctrlx.mobile.JoystickView
                                android:id="@+id/leftStick"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <Button
                                android:id="@+id/btnL3"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentEnd="true"
                                android:text="L3"
                                android:textColor="#94A3B8"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/btn_xbox_small" />

                        </RelativeLayout>

                        <!-- Xbox D-Pad Cross -->
                        <RelativeLayout
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_marginStart="4dp">

                            <!-- D-Pad UP -->
                            <Button
                                android:id="@+id/btnDpadUp"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_centerHorizontal="true"
                                android:layout_alignParentTop="true"
                                android:text="▲"
                                android:textColor="#F1F5F9"
                                android:textSize="13sp"
                                android:background="@drawable/btn_xbox_dpad" />

                            <!-- D-Pad LEFT -->
                            <Button
                                android:id="@+id/btnDpadLeft"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="◀"
                                android:textColor="#F1F5F9"
                                android:textSize="13sp"
                                android:background="@drawable/btn_xbox_dpad" />

                            <!-- D-Pad Center Hub Decorator -->
                            <View
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_centerInParent="true"
                                android:background="#0F172A" />

                            <!-- D-Pad RIGHT -->
                            <Button
                                android:id="@+id/btnDpadRight"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="▶"
                                android:textColor="#F1F5F9"
                                android:textSize="13sp"
                                android:background="@drawable/btn_xbox_dpad" />

                            <!-- D-Pad DOWN -->
                            <Button
                                android:id="@+id/btnDpadDown"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_centerHorizontal="true"
                                android:layout_alignParentBottom="true"
                                android:text="▼"
                                android:textColor="#F1F5F9"
                                android:textSize="13sp"
                                android:background="@drawable/btn_xbox_dpad" />

                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- ================= CENTER CONSOLE ================= -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <!-- Glowing Xbox Guide Button -->
                    <Button
                        android:id="@+id/btnXboxGuide"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="✖"
                        android:textColor="#10B981"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_xbox_guide" />

                    <!-- View & Menu Buttons Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/btnView"
                            android:layout_width="44dp"
                            android:layout_height="30dp"
                            android:text="⧉"
                            android:textColor="#94A3B8"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_xbox_small" />

                        <View
                            android:layout_width="14dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnMenu"
                            android:layout_width="44dp"
                            android:layout_height="30dp"
                            android:text="☰"
                            android:textColor="#94A3B8"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_xbox_small" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CTRLX"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

                <!-- ================= RIGHT WING ================= -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <!-- Right Shoulder Buttons (RB & RT) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end|center_vertical"
                        android:paddingEnd="4dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <Button
                            android:id="@+id/btnRB"
                            android:layout_width="74dp"
                            android:layout_height="36dp"
                            android:text="RB"
                            android:textColor="#E2E8F0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_xbox_shoulder" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="match_parent" />

                        <Button
                            android:id="@+id/btnRT"
                            android:layout_width="84dp"
                            android:layout_height="36dp"
                            android:text="RT"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:background="@drawable/btn_xbox_trigger" />

                    </LinearLayout>

                    <!-- Right Thumb Controls (Right Analog Stick & ABXY Diamond) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Right Analog Stick (RS + R3) -->
                        <RelativeLayout
                            android:layout_width="135dp"
                            android:layout_height="135dp"
                            android:layout_marginEnd="6dp">

                            <com.ctrlx.mobile.JoystickView
                                android:id="@+id/rightStick"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <Button
                                android:id="@+id/btnR3"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_alignParentBottom="true"
                                android:layout_alignParentStart="true"
                                android:text="R3"
                                android:textColor="#94A3B8"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:background="@drawable/btn_xbox_small" />

                        </RelativeLayout>

                        <!-- Xbox ABXY Diamond Cluster -->
                        <RelativeLayout
                            android:layout_width="125dp"
                            android:layout_height="125dp"
                            android:layout_marginStart="8dp">

                            <!-- Y Button (Top / Yellow) -->
                            <Button
                                android:id="@+id/btnY"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_centerHorizontal="true"
                                android:layout_alignParentTop="true"
                                android:text="Y"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:background="@drawable/btn_xbox_y" />

                            <!-- X Button (Left / Blue) -->
                            <Button
                                android:id="@+id/btnX"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:text="X"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:background="@drawable/btn_xbox_x" />

                            <!-- B Button (Right / Red) -->
                            <Button
                                android:id="@+id/btnB"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:text="B"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:background="@drawable/btn_xbox_b" />

                            <!-- A Button (Bottom / Green) -->
                            <Button
                                android:id="@+id/btnA"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_centerHorizontal="true"
                                android:layout_alignParentBottom="true"
                                android:text="A"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:background="@drawable/btn_xbox_a" />

                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>


    <!-- ============================================== -->
    <!-- MONECT-STYLE BOTTOM NAVIGATION BAR             -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#0F172A"
        android:gravity="center_vertical">

        <!-- Tab 1: Connect -->
        <LinearLayout
            android:id="@+id/navTabConnect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navIconConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navLabelConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Tab 2: Touchpad -->
        <LinearLayout
            android:id="@+id/navTabTouchpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navIconTouchpad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖱️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navLabelTouchpad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touchpad"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Tab 3: Gamepad -->
        <LinearLayout
            android:id="@+id/navTabGamepad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/navIconGamepad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/navLabelGamepad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gamepad"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>